# Exemplo de tv3ws/.env com os valores do container. No compose, a secao environment do service tv3ws
# tem precedencia; o resto vem deste arquivo (copiado como tv3ws/.env) ou do .env da raiz, que prevalece.
# Fora de container (npm run dev): MQTT_HOST e REDIS_HOST=127.0.0.1, HTTP_PORT=44654, HTTPS_PORT=44655 e
# USER_THUMBS=../user-files/thumbs (docs/dev-local.md, na raiz do TV30).
# Obrigatorias (o boot falha sem elas): MQTT_HOST, REDIS_HOST, JWT_SECRET, USER_THUMBS

# [REQUIRED] Broker MQTT. Em container = 'mosquitto'.
MQTT_HOST=localhost

# Portas do tv3ws. Em container nao sao publicadas: o cliente entra pela borda (44642/44643).
HTTP_PORT=44652
HTTPS_PORT=44653

# [REQUIRED] Redis. Em container = 'redis'. Comando sem resposta em 1,5 s falha, e a API responde
# 404 {error:200} (src/redis-client.ts).
REDIS_HOST=localhost
REDIS_PORT=6379

# [REQUIRED] Diretorio das imagens de perfil. Em container = /user-files/thumbs (volume de ./user-files).
USER_THUMBS=/user-files/thumbs

# Metadados do /manifest. Opcional, defaults internos.
# BRAND_NAME='GenericBrand'
# MODEL='GenericModel'
# FRIENDLY_NAME='TV 3.0 Receiver'
# UDN='uuid:TV30-1234-5678-9012-345678901234'

# Descoberta SSDP (C.3.4): quem anuncia e o anunciante nativo do host (./tv30 up), e o anuncio aponta para
# a BORDA. O host do /manifest (e do anuncio) e SSDP_ADVERTISE_HOST, se definido; senao o Host original da
# requisicao, que a borda repassa; senao SERVER_URL ou o IP local. Loopback aqui gera aviso no boot.
# EDGE_HTTP_PORT diferente de 44642 deixa o anuncio fora da C.3.4 (so para teste). EDGE_HTTPS_PORT tem de ser
# a porta de host da superficie externa da borda (44643; EDGE_EXT_PUBLISH no .env da raiz): com
# EDGE_EXT_PUBLISH=<porta>:44643, use a mesma <porta>; com so o numero, o /manifest nao a acompanha.
# SSDP_ADVERTISE_HOST=192.168.1.150
# EDGE_HTTP_PORT=44642
# EDGE_HTTPS_PORT=44643

# Host dos websockets de remote-device (wss://SERVER_URL:<porta>); no /manifest, so o ultimo recurso.
SERVER_URL=localhost
# Faixa de portas dos websockets de remote-device (no compose: 45000-45199).
WS_PORT_MIN=45000
WS_PORT_MAX=45199

# [REQUIRED] JWT. Tem de ser o mesmo segredo da borda, que valida o access token; o valor abaixo e o
# default de dev do docker-compose.yml da raiz. Use valores fortes em producao.
JWT_SECRET=tv30-dev-secret-nao-usar-em-producao
JWT_ISSUER=GenericIssuer

# Certificado do receptor: o tls-init do compose o gera em .tv30/tls, montado em /tls. Vale para o HTTPS,
# o serverCert do pareamento e o wss:// do ponto de entrada do dispositivo remoto. Fora do container:
#TV30_TLS_DIR=../.tv30/tls
# [OPCIONAL] Sem TV30_TLS_DIR: chave e certificado em base64. Sem nenhum, so HTTP e ws://.
HTTPS_KEY=
HTTPS_CERT=
# false = ws:// no ponto de entrada do dispositivo remoto mesmo com certificado, para demonstracao com aparelho
# que nao confia no certificado autoassinado. O ponto de entrada local sai sempre em ws://.
#TV3WS_WS_TLS=false

# Logging: ERROR | INFO | DEBUG (default ERROR)
LOG_LEVEL=ERROR
