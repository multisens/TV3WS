# Example of tv3ws/.env with the container values. In the compose, the
# environment section of the tv3ws service takes precedence; the rest comes
# from this file (copied as tv3ws/.env) or from the root .env, which
# prevails. Outside a container (npm run dev): MQTT_HOST and
# REDIS_HOST=127.0.0.1, HTTP_PORT=44654, HTTPS_PORT=44655 and
# USER_THUMBS=../user-files/thumbs (docs/dev-local.md, in the TV30 root).
# Required (startup fails without them): MQTT_HOST, REDIS_HOST, JWT_SECRET,
# JWT_ISSUER, USER_THUMBS, HTTP_PORT, HTTPS_PORT, WS_PORT_MIN, WS_PORT_MAX,
# LISTEN_ATTEMPTS, MAX_REGISTRATIONS, PING_INTERVAL_MS.

# [REQUIRED] MQTT broker. In a container, 'mosquitto'.
MQTT_HOST=localhost

# Ports of tv3ws. In a container they are not published: clients come in
# through the edge (44642/44643).
HTTP_PORT=44652
HTTPS_PORT=44653

# [REQUIRED] Redis. In a container, 'redis'. A command without an answer in
# 1.5 s fails, and the API answers 404 {error:200} (src/redis-client.ts).
REDIS_HOST=localhost
REDIS_PORT=6379

# [REQUIRED] Directory of the profile images. In a container,
# /user-files/thumbs (volume of ./user-files).
USER_THUMBS=/user-files/thumbs

# Metadata of /manifest. Optional, with internal defaults.
# BRAND_NAME='GenericBrand'
# MODEL='GenericModel'
# FRIENDLY_NAME='TV 3.0 Receiver'
# UDN='uuid:TV30-1234-5678-9012-345678901234'

# SSDP discovery (C.3.4): the native announcer of the host (./tv30 up)
# announces, pointing to the EDGE. The host of /manifest (and of the
# announcement) is SSDP_ADVERTISE_HOST, if set; otherwise the original Host
# of the request, passed on by the edge; otherwise SERVER_URL or the local
# IP. Loopback here gives a warning at startup. EDGE_HTTP_PORT other than
# 44642 puts the announcement outside C.3.4 (testing only). EDGE_HTTPS_PORT
# must be the host port of the external surface of the edge (44643;
# EDGE_EXT_PUBLISH in the root .env): with EDGE_EXT_PUBLISH=<port>:44643, use
# the same <port>; with the number alone, /manifest does not follow it.
# SSDP_ADVERTISE_HOST=192.168.1.150
# EDGE_HTTP_PORT=44642
# EDGE_HTTPS_PORT=44643

# Host of the remote-device WebSockets (wss://SERVER_URL:<port>); for
# /manifest, only the last resort.
SERVER_URL=localhost
# Port range of the remote-device WebSockets (in the compose: 45000-45199).
WS_PORT_MIN=45000
WS_PORT_MAX=45199
# Port draws before giving up on opening a WebSocket server (version 100.0).
LISTEN_ATTEMPTS=10
# Receiver limit on registered remote devices (version 100.0).
MAX_REGISTRATIONS=32
# Interval of the keep-alive ping on the WebSockets, in ms (version 100.0).
PING_INTERVAL_MS=15000

# [REQUIRED] JWT. The same secret as the edge, which validates the access
# token; the value below is the development default of the root
# docker-compose.yml. Use strong values in production.
JWT_SECRET=tv30-dev-secret-nao-usar-em-producao
JWT_ISSUER=GenericIssuer

# Receiver certificate: tls-init of the compose generates it in .tv30/tls,
# mounted on /tls. It serves HTTPS, the serverCert of the pairing and the
# wss:// of the entry point of the remote device. Outside the container:
#TV30_TLS_DIR=../.tv30/tls
# [OPTIONAL] Without TV30_TLS_DIR: key and certificate in base64. Without
# any, only HTTP and ws://.
HTTPS_KEY=
HTTPS_CERT=
# false = ws:// at the entry point of the remote device even with a
# certificate. The local entry point is always ws://.
#TV3WS_WS_TLS=false

# Logging: ERROR | INFO | DEBUG (default ERROR).
LOG_LEVEL=ERROR
