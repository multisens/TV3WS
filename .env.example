# Exemplo de tv3ws/.env. Os valores abaixo sao os do CONTAINER (portas
# 44652/44653, /user-files). Em container, o docker-compose.yml do TV30
# (service `tv3ws`) define as variaveis da secao `environment`, que tem
# precedencia; as demais (HTTPS_KEY/HTTPS_CERT, LOG_LEVEL, metadados,
# SSDP_ADVERTISE_HOST) vem deste arquivo copiado como tv3ws/.env, se existir,
# ou do .env da raiz, que o compose le depois deste e que prevalece. O
# anunciante SSDP nativo (./tv30 up) le os mesmos dois arquivos.
#
# Fora de container (npm run dev, cenario dev-host) os valores mudam: MQTT_HOST
# e REDIS_HOST=127.0.0.1, HTTP_PORT=44654 e HTTPS_PORT=44655 (portas que a
# borda espera na variante windows, infra/edgegateway/routes.json) e
# USER_THUMBS apontando para ../user-files/thumbs da raiz. O comando
# completo esta em docs/dev-local.md (raiz do TV30).
#
# Required (server falha no boot se faltar — src/server.ts): MQTT_HOST,
# REDIS_HOST, JWT_SECRET, USER_THUMBS

# [REQUIRED] Hostname do broker MQTT. Em container = nome do service ('mosquitto').
# Fora de container = localhost (broker rodando no host).
MQTT_HOST=localhost

# Portas do proprio tv3ws. Em container sao 44652/44653 e NAO sao publicadas
# no host: o cliente entra pela borda (edgegateway, 44642/44643). No host
# (borda na variante windows): 44654/44655.
HTTP_PORT=44652
HTTPS_PORT=44653

# [REQUIRED] Redis (estado de sessao; perfis so leitura). Em container =
# service 'redis'. Comando que nao obtem resposta em 1,5 s falha e a API
# responde 404 {error:200} (src/redis-client.ts).
REDIS_HOST=localhost
REDIS_PORT=6379

# [REQUIRED] Diretorio das imagens de perfil (thumbs/). Em container =
# /user-files/thumbs (volume montado de ./user-files na raiz do TV30). No host,
# o caminho de ./user-files/thumbs da raiz.
# USER_DATA_FILE nao e mais lido: o tv3ws nao semeia perfis (a carga inicial
# e do container redis; a criacao, do AoP).
USER_THUMBS=/user-files/thumbs

# Metadados de descoberta do webservice. Opcional, defaults internos.
# BRAND_NAME='GenericBrand'
# MODEL='GenericModel'
# FRIENDLY_NAME='TV 3.0 Receiver'
# UDN='uuid:TV30-1234-5678-9012-345678901234'

# Descoberta SSDP (C.3.4). O anuncio aponta para a BORDA, nao para o tv3ws:
# LOCATION = http://<host>:<EDGE_HTTP_PORT>/manifest, e o /manifest devolve
# Server-BaseURL=<host>:<EDGE_HTTP_PORT> e Server-SecureBaseURL=<host>:<EDGE_HTTPS_PORT>.
# <host> do /manifest = SSDP_ADVERTISE_HOST, senao o host da requisicao (o
# Host original, que a borda repassa), senao SERVER_URL, senao o IP local.
# SSDP_ADVERTISE_HOST de loopback gera AVISO no boot: cliente em outro
# equipamento nao alcanca o LOCATION. EDGE_HTTP_PORT diferente
# de 44642 deixa o anuncio fora da C.3.4 (so para teste). EDGE_HTTPS_PORT tem
# de ser a porta de host da superficie externa da borda: 44643, fixa por
# padrao tambem na bridge desde 12/10 (decisao do Luis; EDGE_EXT_PUBLISH no
# .env da raiz). Com EDGE_EXT_PUBLISH=<porta>:44643, use a mesma <porta> aqui
# (ou no .env da raiz); com EDGE_EXT_PUBLISH=44643 (so o numero, porta
# escolhida pelo Docker), o /manifest nao a acompanha.
# SSDP_ADVERTISE_HOST, definido, fixa o host do /manifest (e do anuncio, no
# ./tv30 up); sem ele, o host de cada resposta do /manifest sai da requisicao
# (o Host original, que a borda repassa; complemento do Joel de 15/10).
# SSDP_ADVERTISE_HOST=192.168.1.150
# EDGE_HTTP_PORT=44642
# EDGE_HTTPS_PORT=44643
#
# Quem anuncia: o anunciante nativo do host (infra/edgegateway/ssdp, subido
# pelo ./tv30 up; complemento do Joel de 15/10). O tv3ws so serve o
# /manifest; o anunciante Node que ele rodava com npm run dev saiu nessa data.

# Host que dispositivos externos usam pra abrir o websocket de remote-device
# (wss://SERVER_URL:<porta> com o certificado do receptor, A7); o /manifest so
# o usa sem SSDP_ADVERTISE_HOST e sem cabecalho de host na requisicao.
SERVER_URL=localhost
# Faixa de portas dos websockets de remote-device (no compose: 45000-45199).
WS_PORT_MIN=45000
WS_PORT_MAX=45199

# [REQUIRED] JWT — usar valores fortes em producao. Tem de ser o MESMO
# segredo da borda (edgegateway valida o access token com ele); o valor
# abaixo e o default de dev do docker-compose.yml da raiz.
JWT_SECRET=tv30-dev-secret-nao-usar-em-producao
JWT_ISSUER=GenericIssuer

# Certificado do receptor (A7, Joel em 15/10): o tls-init do compose o gera
# em .tv30/tls na primeira subida, e o tv3ws o le de TV30_TLS_DIR (no compose,
# /tls). Ele vale para o HTTPS da 44653, o serverCert do pareamento e os wss://
# do remote-device (src/tls.ts). Fora do container (npm run dev):
# TV30_TLS_DIR=../.tv30/tls.
#TV30_TLS_DIR=../.tv30/tls
# [OPCIONAL] Sem TV30_TLS_DIR: chave e certificado em base64 (RSA + X.509).
# Sem nenhum dos dois, o tv3ws sobe so em HTTP, e os pontos de entrada saem em
# ws://.
HTTPS_KEY=
HTTPS_CERT=
# false = pontos de entrada do remote-device em ws:// mesmo com certificado
# (um navegador nao abre wss:// com certificado autoassinado em que nao confia)
#TV3WS_WS_TLS=false

# Logging: ERROR | INFO | DEBUG (default ERROR)
LOG_LEVEL=ERROR
